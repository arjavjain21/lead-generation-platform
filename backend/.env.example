# JWT Secret - generate a random string
JWT_SECRET=change-this-to-a-random-secret-key

# Scraper API Key (for Google Maps scraping)
SCRAPER_TECH_KEY=your-scraper-tech-api-key

# Blitz API Key (for domain enrichment)
BLITZ_API_KEY=your-blitz-api-key
# Blitz client rate caps, requests/sec (legacy plan 2026-09: 50 RPS PER ENDPOINT
# in separate buckets, 15M records/month fair use; limiters are per-process so
# we cap below 50 by default). BLITZ_RPS is the default for every lane; the
# per-lane overrides pace /email, discovery (domain-to-linkedin etc.) and
# /v2/search/* independently.
# BLITZ_RPS=40
# BLITZ_RPS_EMAIL=40
# BLITZ_RPS_DISCOVERY=40
# BLITZ_RPS_SEARCH=40

# SmartLead Find Emails API (smartprospect provider, prospect-api.smartlead.ai)
SMARTPROSPECT_API_KEY=your-smartprospect-api-key
ENABLE_SMARTPROSPECT=true
# Shared cross-process token bucket (all gunicorn workers; account cap is
# 2000 req/min — default leaves a 5% margin). Burst = max tokens banked.
# SMARTPROSPECT_RATE_LIMIT_RPM=1900
# SMARTPROSPECT_RATE_LIMIT_BURST=2

# GetLeads (app.getleads.io)
GETLEADS_API_KEY=your-getleads-api-key
ENABLE_GETLEADS=true

# Contacts DB API (for enrichment fallback and scraper sync)
CONTACTS_API_BASE_URL=https://leadsdatabase.cc
CONTACTS_API_TOKEN=your-contacts-api-token

# Mailtester API (for email verification)
MAILTESTER_API_KEY=your-mailtester-api-key
# Accept policy: "ok" (strict, default) or "ok,mb" (legacy lenient)
MAILTESTER_ACCEPT_CODES=ok

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Website-scrape nightly sync (webscraper.eagleinfoservice.com → Contacts DB)
# Default DISABLED — flip to true only for the scheduled backfill/go-live.
# Transport: ssh alias 'webscraper-vps' (key auth, ~/.ssh/id_ed25519_webscraper);
# remote psql runs as SELECT-only role 'leadgen_sync' (no DB secrets here).
WEBSITE_SCRAPE_SYNC_ENABLED=false
WEBSITE_SCRAPE_BATCH_SIZE=500
WEBSITE_SCRAPE_SYNC_RPS=40
WEBSITE_SCRAPE_SHARED_ND_CAP=20
WEBSITE_SCRAPE_TIMEOUT_S=300

# External scraper API + MCP action tools — API-key surface (/api/external/scraper/*)
ENABLE_EXTERNAL_SCRAPER_API=true
ENABLE_MCP_SCRAPER_TOOLS=true
MAX_EXTERNAL_SCRAPER_TASKS=15000
