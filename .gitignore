# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local

# Data files (keep folder, exclude contents)
backend/data/
!backend/data/.gitkeep
*.csv

# Scraper data files (keep only essential)
backend/scraper/data/*.csv
# Allow European country center files (major cities for geographic coverage)
!backend/scraper/data/de_centers.csv
!backend/scraper/data/fr_centers.csv
!backend/scraper/data/es_centers.csv
!backend/scraper/data/it_centers.csv
!backend/scraper/data/nl_centers.csv
!backend/scraper/data/be_centers.csv
!backend/scraper/data/pl_centers.csv
!backend/scraper/data/se_centers.csv
!backend/scraper/data/dk_centers.csv
!backend/scraper/data/at_centers.csv
!backend/scraper/data/ch_centers.csv
!backend/scraper/data/pt_centers.csv
!backend/scraper/data/no_centers.csv
!backend/scraper/data/nz_centers.csv
!backend/scraper/data/.gitkeep
# Allow Canada expansion files (ca_centers.csv generated from ca_cities_statscan.csv)
!backend/scraper/data/ca_centers.csv
!backend/scraper/data/ca_centers.csv.backup
!backend/scraper/data/ca_cities_statscan.csv
# Allow Latin American country center files (generated from GeoNames cities15000 by generate_country_centers.py)
!backend/scraper/data/mx_centers.csv
!backend/scraper/data/br_centers.csv
!backend/scraper/data/ar_centers.csv
!backend/scraper/data/co_centers.csv
!backend/scraper/data/cl_centers.csv
!backend/scraper/data/pe_centers.csv
!backend/scraper/data/ve_centers.csv
!backend/scraper/data/ec_centers.csv
!backend/scraper/data/bo_centers.csv
!backend/scraper/data/py_centers.csv
!backend/scraper/data/uy_centers.csv
!backend/scraper/data/geonames_cities15000.txt
!backend/scraper/data/admin1CodesASCII.txt
# Allow template CSV files for user downloads
!backend/scraper/data/templates/*.csv

# Node modules (if any)
node_modules/

# OS
.DS_Store
Thumbs.db

# Logs (except new structured logs folder - will be tracked in archive)
logs/
*.log

# Frontend build (regenerate from source)
frontend/assets/*.js
frontend/assets/*.css

# Temp files
*.tmp
*.temp

# Worktrees (isolated development workspaces)
.worktrees/

# Archive (not tracked - contains old backups and dated files)
archive/

# Databases - don't commit these
*.db
*.db-shm
*.db-wal

# Cache and temporary files
__pycache__/
*.pyc
.env
rollback_backup_*/

# Backups (runtime DB dumps and service snapshots — large, not source)
backups/

# Test coverage artifacts
backend/.coverage
.coverage
htmlcov/

# Local Claude Code workspace (skills, plans, agent configs — not project source)
.claude/
.loop/

# External reference clones (kept locally for reading, not vendored into repo)
docs/blitz-api-py/
LOOP-latam.md
